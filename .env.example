# ── Backend (required) ─────────────────────────
MONGO_URI=mongodb://USER:PASS@HOST:27017/
MONGO_DB=ev_monitor
MQTT_URL=mqtt://MQTT_HOST:1883
WS_PORT=4100
HEARTBEAT_TIMEOUT_MS=300000

# ── Config page protection ─────────────────────
# PIN required to access /config and POST /api/stations/save
CONFIG_PIN=1234

# ── Frontend (optional overrides) ──────────────
# Leave UNSET in production — frontend auto-detects hostname from window.location
# Only set these when serving WS/API on a different domain (e.g. behind nginx).
#
# NEXT_PUBLIC_WS_URL=wss://dashboard.example.com/ws
# NEXT_PUBLIC_API_URL=https://dashboard.example.com/api

# ── Vector vSECC Log Manager (station page → Manager Log tab) ──
# WebUI account used only for reading logs (same on every station).
# VSECC_USERNAME=…
# VSECC_PASSWORD=…
# vSECC address inside the cabinet LAN (used when the station's ZeroTier field is a network ID).
# Cabinets differ: one vSECC at .11 or .12, or two (both). Every address is tried; each vSECC that answers is
# collected and stored separately, and the Manager Log tab gets a vSECC selector when there are two.
# VSECC_LAN_URLS=http://192.168.3.11/api,http://192.168.3.12/api
# Used only when the ZeroTier field holds an IP; {zerotierIp} is replaced.
# VSECC_URL_TEMPLATE=http://{zerotierIp}/api
# Background collector: pulls new log lines from every Vector station and stores them on disk,
# so the Manager Log tab opens instantly. Stations on ZeroTier network IDs are visited one at a
# time, so each station refreshes every max(interval, time to visit all stations).
# VSECC_COLLECTOR=1                  (0 = off)
# VSECC_COLLECT_INTERVAL_SEC=30
# VSECC_LOG_DIR=D:\dashboard3\data\vsecc-logs   (default <project>/data/vsecc-logs)
# VSECC_LOG_RETENTION_DAYS=7
# Offline chargers are retried after 2, 4, 8, 16 … up to this many minutes (↻ Refresh tries at once)
# VSECC_OFFLINE_MAX_MIN=30
# Addresses that never answered are re-tried this often (picks up a vSECC added later)
# VSECC_PROBE_MINUTES=30
# VSECC_COLLECT_FILES=^(charging-manager|vsecc)   (regex; default: every log file)

# ── ZeroTier automation (server joins one station network at a time) ──
# Central API token from my.zerotier.com → Account → API Access Tokens
# ZEROTIER_API_TOKEN=…
# Contents of C:\ProgramData\ZeroTier\One\authtoken.secret (local service auth)
# ZEROTIER_LOCAL_TOKEN=…
# Leave the station network after N minutes without Manager Log use (0 = stay joined)
# ZEROTIER_IDLE_LEAVE_MINUTES=10

# ── Users, roles & audit log ──────────────────
# Built-in admin (always works, cannot be deleted from the UI). Other users are
# managed on the Users & Roles page and stored in MongoDB Station._users.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=…
# AUTH_SECRET=<random 32+ chars — signs session cookies; changing it logs everyone out>
# Days to keep audit log entries (Station._audit_log, TTL index)
# AUDIT_RETENTION_DAYS=365
